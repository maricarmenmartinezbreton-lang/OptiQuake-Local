{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OptiQuake Local Plugin Manifest",
  "type": "object",
  "required": ["name", "version", "api_version", "kind", "entrypoint"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "api_version": {"const": "1"},
    "kind": {
      "enum": ["event-consumer", "alert", "storage", "ai-bridge", "visualization", "research"]
    },
    "entrypoint": {"type": "string", "minLength": 1},
    "author": {"type": "string"},
    "license": {"type": "string"},
    "homepage": {"type": "string"},
    "description": {"type": "string"}
  },
  "additionalProperties": true
}
